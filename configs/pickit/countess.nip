// Countess Pickit MVP.
// Pfad relativ zur geladenen Config: configs/config.yaml -> configs/pickit/countess.nip.
// Unterstuetzt wird nur der kleine Phase-5.3-Subset: [name], [type], [quality], [flag], [stat:<id>].

// Runen.
[type] == rune

// Countess-Key.
[name] == pk1

// Rejuvenation Potions sind nicht kaufbar und werden deshalb als Loot aufgenommen.
[type] == rpot

// Flawless und Perfect Gems.
[name] == gzv || [name] == gpv
[name] == gly || [name] == gpy
[name] == glb || [name] == gpb
[name] == glg || [name] == gpg
[name] == glr || [name] == gpr
[name] == glw || [name] == gpw
[name] == skl || [name] == skz

// Spaetere Beispiele, aktuell bewusst aus.
// [name] == pk2 || [name] == pk3
// [type] == gold
// [type] == hpot || [type] == mpot
