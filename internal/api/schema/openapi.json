{
  "openapi": "3.1.0",
  "info": {"title": "D2R Offline Farming Bot Local Core API", "version": "1.0.0"},
  "servers": [{"url": "http://127.0.0.1:{port}", "variables": {"port": {"default": "0"}}}],
  "paths": {
    "/api/v1/status": {"get": {"operationId": "getStatus", "responses": {"200": {"description": "Supervisor status", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StatusDTO"}}}}}}},
    "/api/v1/catalog": {"get": {"operationId": "getCatalog", "responses": {"200": {"description": "Catalog snapshot", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CatalogDTO"}}}}}}},
    "/api/v1/events": {"get": {"operationId": "getEvents", "responses": {"200": {"description": "Server-sent event stream"}}}},
    "/api/v1/selection/preview": {"post": {"operationId": "previewSelection", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SelectionPreviewRequest"}}}}, "responses": {"200": {"description": "Revision-bound selection preview", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SelectionPreviewDTO"}}}}}}},
    "/api/v1/selection/apply": {"post": {"operationId": "applySelection", "requestBody": {"$ref": "#/components/requestBodies/Command"}, "responses": {"200": {"$ref": "#/components/responses/Command"}}}},
    "/api/v1/queue/validate": {"post": {"operationId": "validateQueue", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QueueValidationRequest"}}}}, "responses": {"200": {"description": "Validated immutable queue plan", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QueueValidationDTO"}}}}}}},
    "/api/v1/session/start": {"post": {"operationId": "startSession", "requestBody": {"$ref": "#/components/requestBodies/Command"}, "responses": {"200": {"$ref": "#/components/responses/Command"}}}},
    "/api/v1/session/pause-after-run": {"post": {"operationId": "pauseAfterRun", "requestBody": {"$ref": "#/components/requestBodies/Command"}, "responses": {"200": {"$ref": "#/components/responses/Command"}}}},
    "/api/v1/session/resume": {"post": {"operationId": "resumeSession", "requestBody": {"$ref": "#/components/requestBodies/Command"}, "responses": {"200": {"$ref": "#/components/responses/Command"}}}},
    "/api/v1/session/stop-after-run": {"post": {"operationId": "stopAfterRun", "requestBody": {"$ref": "#/components/requestBodies/Command"}, "responses": {"200": {"$ref": "#/components/responses/Command"}}}},
    "/api/v1/session/emergency-stop": {"post": {"operationId": "emergencyStop", "requestBody": {"$ref": "#/components/requestBodies/Command"}, "responses": {"200": {"$ref": "#/components/responses/Command"}}}}
  },
  "components": {
    "requestBodies": {"Command": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CommandRequest"}}}}},
    "responses": {"Command": {"description": "Accepted command", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CommandResponse"}}}}},
    "schemas": {
      "StatusDTO": {"type": "object", "required": ["schema_version", "core_version", "state", "generation", "lifecycle_phase", "d2r", "input", "world", "selection", "queue"], "properties": {"schema_version": {"type": "integer"}, "core_version": {"type": "string"}, "state": {"type": "string"}, "generation": {"type": "integer"}, "lifecycle_phase": {"type": "string"}, "pending_intent": {"type": "string"}, "active_run_id": {"type": "string"}, "run_id": {"type": "string"}, "game_id": {"type": "string"}, "step": {"type": "string"}, "d2r": {"$ref": "#/components/schemas/D2RDTO"}, "input": {"$ref": "#/components/schemas/InputDTO"}, "world": {"$ref": "#/components/schemas/WorldDTO"}, "selection": {"$ref": "#/components/schemas/SelectionStatusDTO"}, "queue": {"$ref": "#/components/schemas/QueueStatusDTO"}, "last_result": {"$ref": "#/components/schemas/SessionResultDTO"}, "last_error": {"$ref": "#/components/schemas/ErrorDTO"}}},
      "SessionResultDTO": {"type": "object", "required": ["disposition"], "properties": {"disposition": {"type": "string"}, "reason": {"type": "string"}}},
      "SelectionStatusDTO": {"type": "object", "properties": {"character": {"type": "string"}, "difficulty": {"type": "string"}}},
      "QueueStatusDTO": {"type": "object", "required": ["entries", "default_entries", "index", "cycle", "retry", "started_runs", "consecutive_failures", "total_restarts", "budgets"], "properties": {"entries": {"type": "array", "items": {"type": "string"}}, "default_entries": {"type": "array", "items": {"type": "string"}}, "index": {"type": "integer"}, "cycle": {"type": "integer"}, "retry": {"type": "integer"}, "started_runs": {"type": "integer"}, "consecutive_failures": {"type": "integer"}, "total_restarts": {"type": "integer"}, "budgets": {"$ref": "#/components/schemas/QueueBudgetsDTO"}}},
      "QueueBudgetsDTO": {"type": "object", "required": ["max_runs", "max_duration_ms", "max_consecutive_failures", "max_total_restarts"], "properties": {"max_runs": {"type": "integer"}, "max_duration_ms": {"type": "integer"}, "max_consecutive_failures": {"type": "integer"}, "max_total_restarts": {"type": "integer"}}},
      "D2RDTO": {"type": "object", "required": ["state", "window_bound"], "properties": {"state": {"type": "string"}, "pid": {"type": "integer"}, "window_bound": {"type": "boolean"}, "client_width": {"type": "integer"}, "client_height": {"type": "integer"}}},
      "InputDTO": {"type": "object", "required": ["enabled", "paused", "stopped"], "properties": {"enabled": {"type": "boolean"}, "paused": {"type": "boolean"}, "stopped": {"type": "boolean"}}},
      "WorldDTO": {"type": "object", "required": ["valid", "phase"], "properties": {"valid": {"type": "boolean"}, "phase": {"type": "string"}, "area_id": {"type": "integer"}, "area_name": {"type": "string"}}},
      "LiveEvent": {"type": "object", "required": ["sequence", "timestamp", "event"], "properties": {"sequence": {"type": "integer"}, "timestamp": {"type": "string"}, "event": {"type": "string"}, "session_id": {"type": "string"}, "game_id": {"type": "string"}, "run_id": {"type": "string"}, "run": {"type": "string"}, "step": {"type": "string"}, "area_id": {"type": "integer"}, "area": {"type": "string"}, "reason": {"type": "string"}, "details": {"type": "object"}}},
      "CatalogDTO": {"type": "object", "required": ["schema_version", "revision", "default_difficulty", "characters", "difficulties", "profiles", "runs"], "properties": {"schema_version": {"type": "integer"}, "revision": {"type": "integer"}, "default_difficulty": {"type": "string"}, "characters": {"type": "array", "items": {"$ref": "#/components/schemas/CharacterCatalogEntry"}}, "difficulties": {"type": "array", "items": {"$ref": "#/components/schemas/DifficultyCatalogEntry"}}, "profiles": {"type": "array", "items": {"$ref": "#/components/schemas/ProfileCatalogEntry"}}, "runs": {"type": "array", "items": {"$ref": "#/components/schemas/RunCatalogEntry"}}}},
      "CharacterCatalogEntry": {"type": "object", "required": ["name", "slug", "selectable"], "properties": {"name": {"type": "string"}, "slug": {"type": "string"}, "expected_class": {"type": "string"}, "selectable": {"type": "boolean"}, "reasons": {"type": "array", "items": {"type": "string"}}}},
      "DifficultyCatalogEntry": {"type": "object", "required": ["id", "display_name"], "properties": {"id": {"type": "string"}, "display_name": {"type": "string"}}},
      "ProfileCatalogEntry": {"type": "object", "required": ["id", "character_class"], "properties": {"id": {"type": "string"}, "character_class": {"type": "string"}}},
      "RunCatalogEntry": {"type": "object", "required": ["run_id", "display_name", "status"], "properties": {"run_id": {"type": "string"}, "display_name": {"type": "string"}, "status": {"type": "string"}, "reasons": {"type": "array", "items": {"type": "string"}}}},
      "CommandRequest": {"type": "object", "required": ["command_id", "expected_generation"], "additionalProperties": false, "properties": {"command_id": {"type": "string"}, "expected_generation": {"type": "integer"}, "payload": {"type": "object"}}},
      "CommandResponse": {"type": "object", "required": ["schema_version", "command_id", "generation", "state"], "properties": {"schema_version": {"type": "integer"}, "command_id": {"type": "string"}, "generation": {"type": "integer"}, "state": {"type": "string"}}},
      "SelectionPreviewRequest": {"type": "object", "required": ["character", "difficulty", "catalog_revision"], "additionalProperties": false, "properties": {"character": {"type": "string"}, "difficulty": {"type": "string"}, "catalog_revision": {"type": "integer"}}},
      "SelectionPreviewDTO": {"type": "object", "required": ["schema_version", "character", "new_difficulty", "affected_routes", "requires_confirmation", "confirmation_token", "catalog_revision", "lifecycle_revision"], "properties": {"schema_version": {"type": "integer"}, "character": {"type": "string"}, "old_difficulty": {"type": "string"}, "new_difficulty": {"type": "string"}, "affected_routes": {"type": "array", "items": {"type": "string"}}, "invalidation_reason": {"type": "string"}, "requires_confirmation": {"type": "boolean"}, "confirmation_token": {"type": "string"}, "catalog_revision": {"type": "integer"}, "lifecycle_revision": {"type": "integer"}}},
      "QueueValidationRequest": {"type": "object", "required": ["entries", "character", "difficulty", "catalog_revision"], "additionalProperties": false, "properties": {"entries": {"type": "array", "items": {"type": "string"}}, "character": {"type": "string"}, "difficulty": {"type": "string"}, "catalog_revision": {"type": "integer"}}},
      "QueueValidationDTO": {"type": "object", "required": ["schema_version", "entries", "character", "difficulty", "catalog_revision", "budgets"], "properties": {"schema_version": {"type": "integer"}, "entries": {"type": "array", "items": {"type": "string"}}, "character": {"type": "string"}, "difficulty": {"type": "string"}, "catalog_revision": {"type": "integer"}, "budgets": {"$ref": "#/components/schemas/QueueBudgetsDTO"}}},
      "SessionStartPayload": {"type": "object", "additionalProperties": false, "required": ["entries", "character", "difficulty", "catalog_revision"], "properties": {"entries": {"type": "array", "items": {"type": "string"}}, "character": {"type": "string"}, "difficulty": {"type": "string"}, "catalog_revision": {"type": "integer"}}},
      "ErrorDTO": {"type": "object", "required": ["code", "message", "request_id"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "details": {"type": "object"}, "request_id": {"type": "string"}}}
    }
  }
}
