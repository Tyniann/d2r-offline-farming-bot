{
  "openapi": "3.1.0",
  "info": {"title": "D2R Offline Farming Bot Local Core API", "version": "1.0.0"},
  "servers": [{"url": "http://127.0.0.1:{port}", "variables": {"port": {"default": "0"}}}],
  "paths": {
    "/api/v1/status": {"get": {"operationId": "getStatus", "responses": {"200": {"description": "Supervisor status", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StatusDTO"}}}}}}},
    "/api/v1/catalog": {"get": {"operationId": "getCatalog", "responses": {"200": {"description": "Catalog snapshot", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CatalogDTO"}}}}}}},
    "/api/v1/history/summary": {"get": {"operationId": "getHistorySummary", "parameters": [{"$ref": "#/components/parameters/HistoryFrom"}, {"$ref": "#/components/parameters/HistoryTo"}, {"$ref": "#/components/parameters/HistoryRun"}, {"$ref": "#/components/parameters/HistoryCharacter"}, {"$ref": "#/components/parameters/HistoryDifficulty"}, {"$ref": "#/components/parameters/HistoryOutcome"}, {"$ref": "#/components/parameters/HistoryReason"}, {"$ref": "#/components/parameters/HistoryPickitProfile"}], "responses": {"200": {"description": "Filtered history summary", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HistorySummaryResponse"}}}}}}},
    "/api/v1/history/comparisons": {"get": {"operationId": "getHistoryComparisons", "parameters": [{"$ref": "#/components/parameters/HistoryFrom"}, {"$ref": "#/components/parameters/HistoryTo"}, {"$ref": "#/components/parameters/HistoryRun"}, {"$ref": "#/components/parameters/HistoryCharacter"}, {"$ref": "#/components/parameters/HistoryDifficulty"}, {"$ref": "#/components/parameters/HistoryOutcome"}, {"$ref": "#/components/parameters/HistoryReason"}, {"$ref": "#/components/parameters/HistoryPickitProfile"}, {"$ref": "#/components/parameters/HistoryComparisonSort"}], "responses": {"200": {"description": "Filtered route comparisons", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HistoryComparisonsResponse"}}}}}}},
    "/api/v1/history/items": {"get": {"operationId": "getHistoryItems", "parameters": [{"$ref": "#/components/parameters/HistoryFrom"}, {"$ref": "#/components/parameters/HistoryTo"}, {"$ref": "#/components/parameters/HistoryRun"}, {"$ref": "#/components/parameters/HistoryCharacter"}, {"$ref": "#/components/parameters/HistoryDifficulty"}, {"$ref": "#/components/parameters/HistoryOutcome"}, {"$ref": "#/components/parameters/HistoryReason"}, {"$ref": "#/components/parameters/HistoryPickitProfile"}, {"$ref": "#/components/parameters/HistoryLimit"}, {"$ref": "#/components/parameters/HistoryCursor"}], "responses": {"200": {"description": "Filtered paginated item history", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HistoryItemsResponse"}}}}}}},
    "/api/v1/history/runs": {"get": {"operationId": "getHistoryRuns", "parameters": [{"$ref": "#/components/parameters/HistoryFrom"}, {"$ref": "#/components/parameters/HistoryTo"}, {"$ref": "#/components/parameters/HistoryRun"}, {"$ref": "#/components/parameters/HistoryCharacter"}, {"$ref": "#/components/parameters/HistoryDifficulty"}, {"$ref": "#/components/parameters/HistoryOutcome"}, {"$ref": "#/components/parameters/HistoryReason"}, {"$ref": "#/components/parameters/HistoryPickitProfile"}, {"$ref": "#/components/parameters/HistoryLimit"}, {"$ref": "#/components/parameters/HistoryCursor"}], "responses": {"200": {"description": "Filtered paginated runs", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HistoryRunsResponse"}}}}}}},
    "/api/v1/history/runs/{runID}": {"get": {"operationId": "getHistoryRun", "parameters": [{"name": "runID", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "include_raw", "in": "query", "schema": {"type": "boolean", "default": false}}], "responses": {"200": {"description": "Semantic run detail", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HistoryRunDetailResponse"}}}}}}},
    "/api/v1/history/export": {"get": {"operationId": "exportHistory", "parameters": [{"$ref": "#/components/parameters/HistoryFrom"}, {"$ref": "#/components/parameters/HistoryTo"}, {"$ref": "#/components/parameters/HistoryRun"}, {"$ref": "#/components/parameters/HistoryCharacter"}, {"$ref": "#/components/parameters/HistoryDifficulty"}, {"$ref": "#/components/parameters/HistoryOutcome"}, {"$ref": "#/components/parameters/HistoryReason"}, {"$ref": "#/components/parameters/HistoryPickitProfile"}, {"name": "format", "in": "query", "required": true, "schema": {"type": "string", "enum": ["json", "csv"]}}, {"name": "dataset", "in": "query", "schema": {"type": "string", "enum": ["runs", "items"]}}], "responses": {"200": {"description": "Filtered JSON report or CSV table"}}}},
    "/api/v1/pickit/catalog": {"get": {"operationId": "getPickitCatalog", "responses": {"200": {"description": "Patch-specific Pickit catalog", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PickitCatalogDTO"}}}}}}},
    "/api/v1/pickit/profiles": {"get": {"operationId": "getPickitProfiles", "responses": {"200": {"description": "Pickit profiles", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PickitProfilesDTO"}}}}}}, "post": {"operationId": "createPickitProfile", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PickitCreateRequest"}}}}, "responses": {"201": {"description": "Created profile", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PickitProfileDTO"}}}}}}},
    "/api/v1/pickit/profiles/validate": {"post": {"operationId": "validatePickitProfile", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PickitValidationRequest"}}}}, "responses": {"200": {"description": "Canonical valid draft", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PickitValidationDTO"}}}}}}},
    "/api/v1/pickit/preview": {"post": {"operationId": "previewPickit", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PickitPreviewRequest"}}}}, "responses": {"200": {"description": "Controlled preview", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PickitPreviewDTO"}}}}}}},
    "/api/v1/pickit/profiles/{profileID}": {"put": {"operationId": "updatePickitProfile", "parameters": [{"name": "profileID", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PickitUpdateRequest"}}}}, "responses": {"200": {"description": "Updated profile", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PickitProfileDTO"}}}}}}, "delete": {"operationId": "deletePickitProfile", "parameters": [{"name": "profileID", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PickitDeleteRequest"}}}}, "responses": {"204": {"description": "Deleted profile"}}}},
    "/api/v1/pickit/profiles/{profileID}/duplicate": {"post": {"operationId": "duplicatePickitProfile", "parameters": [{"name": "profileID", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PickitDuplicateRequest"}}}}, "responses": {"201": {"description": "Duplicated profile", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PickitProfileDTO"}}}}}}},
    "/api/v1/pickit/profiles/{profileID}/export": {"get": {"operationId": "exportPickitProfile", "parameters": [{"name": "profileID", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Portable NIP export", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PickitExportDTO"}}}}}}},
    "/api/v1/pickit/assignments": {"get": {"operationId": "getPickitAssignments", "responses": {"200": {"description": "Pickit assignments", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PickitAssignmentsDTO"}}}}}}, "put": {"operationId": "updatePickitAssignment", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PickitAssignmentUpdateRequest"}}}}, "responses": {"200": {"description": "Updated assignments", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PickitAssignmentsDTO"}}}}}}},
    "/api/v1/pickit/import": {"post": {"operationId": "importPickit", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PickitImportRequest"}}}}, "responses": {"200": {"description": "Imported draft", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PickitImportDTO"}}}}}}},
    "/api/v1/events": {"get": {"operationId": "getEvents", "responses": {"200": {"description": "Server-sent event stream"}}}},
    "/api/v1/routes": {"get": {"operationId": "getRouteLibrary", "responses": {"200": {"description": "Path-free Farming route library", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RouteLibraryDTO"}}}}}}},
    "/api/v1/route-recording/options": {"get": {"operationId": "getRecordingOptions", "responses": {"200": {"description": "Recording contracts", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/RecordingOptionDTO"}}}}}}}},
    "/api/v1/route-recordings": {"post": {"operationId": "startRouteRecording", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RouteRecordingStartRequest"}}}}, "responses": {"202": {"description": "Recording accepted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RouteWorkflowDTO"}}}}}}},
    "/api/v1/route-recordings/{workflowID}/finish": {"post": {"operationId": "finishRouteRecording", "parameters": [{"name": "workflowID", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RouteWorkflowFinishRequest"}}}}, "responses": {"202": {"description": "Finish accepted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RouteWorkflowDTO"}}}}}}},
    "/api/v1/route-candidates/{candidateID}/test": {"post": {"operationId": "testRouteCandidate", "parameters": [{"name": "candidateID", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RouteWorkflowFinishRequest"}}}}, "responses": {"202": {"description": "Candidate test accepted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RouteWorkflowDTO"}}}}}}},
    "/api/v1/route-candidates/{candidateID}/publish/{stage}": {"post": {"operationId": "mutateRouteCandidate", "parameters": [{"name": "candidateID", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "stage", "in": "path", "required": true, "schema": {"type": "string", "enum": ["preview", "confirm"]}}], "responses": {"200": {"description": "Candidate publish preview or confirmation"}}}},
    "/api/v1/routes/{routeID}/{operation}/{stage}": {"post": {"operationId": "mutateRoute", "parameters": [{"name": "routeID", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "operation", "in": "path", "required": true, "schema": {"type": "string", "enum": ["archive", "restore", "delete"]}}, {"name": "stage", "in": "path", "required": true, "schema": {"type": "string", "enum": ["preview", "confirm"]}}], "responses": {"200": {"description": "Route mutation preview or confirmation"}}}},
    "/api/v1/routes/candidates": {"get": {"operationId": "getRouteCandidates", "responses": {"200": {"description": "Path-free candidates", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/RouteCandidateDTO"}}}}}}}},
    "/api/v1/system-routes/status": {"get": {"operationId": "getSystemRouteStatus", "responses": {"200": {"description": "Global Egress readiness", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/SystemRouteStatusDTO"}}}}}}}},
    "/api/v1/routes/hotkeys": {"get": {"operationId": "getHotkeyHelp", "responses": {"200": {"description": "Effective Core hotkeys", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HotkeyHelpDTO"}}}}}}},
    "/api/v1/routes/workflow": {"get": {"operationId": "getRouteWorkflow", "responses": {"200": {"description": "Exclusive route workflow", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RouteWorkflowDTO"}}}}}}},
    "/api/v1/routes/workflow/start": {"post": {"operationId": "startRouteWorkflow", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RouteWorkflowRequest"}}}}, "responses": {"202": {"description": "Workflow accepted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RouteWorkflowDTO"}}}}}}},
    "/api/v1/routes/preview": {"post": {"operationId": "previewRouteMutation", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RouteMutationPreviewRequest"}}}}, "responses": {"200": {"description": "Revision-bound mutation preview", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RouteMutationPreviewDTO"}}}}}}},
    "/api/v1/routes/confirm": {"post": {"operationId": "confirmRouteMutation", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RouteMutationConfirmRequest"}}}}, "responses": {"200": {"description": "Mutation completed"}}}},
    "/api/v1/selection/preview": {"post": {"operationId": "previewSelection", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SelectionPreviewRequest"}}}}, "responses": {"200": {"description": "Revision-bound selection preview", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SelectionPreviewDTO"}}}}}}},
    "/api/v1/selection/apply": {"post": {"operationId": "applySelection", "requestBody": {"$ref": "#/components/requestBodies/Command"}, "responses": {"200": {"$ref": "#/components/responses/Command"}}}},
    "/api/v1/queue/validate": {"post": {"operationId": "validateQueue", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QueueValidationRequest"}}}}, "responses": {"200": {"description": "Validated immutable queue plan", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QueueValidationDTO"}}}}}}},
    "/api/v1/session/start": {"post": {"operationId": "startSession", "requestBody": {"$ref": "#/components/requestBodies/Command"}, "responses": {"200": {"$ref": "#/components/responses/Command"}}}},
    "/api/v1/session/pause-after-run": {"post": {"operationId": "pauseAfterRun", "requestBody": {"$ref": "#/components/requestBodies/Command"}, "responses": {"200": {"$ref": "#/components/responses/Command"}}}},
    "/api/v1/session/resume": {"post": {"operationId": "resumeSession", "requestBody": {"$ref": "#/components/requestBodies/Command"}, "responses": {"200": {"$ref": "#/components/responses/Command"}}}},
    "/api/v1/session/stop-after-run": {"post": {"operationId": "stopAfterRun", "requestBody": {"$ref": "#/components/requestBodies/Command"}, "responses": {"200": {"$ref": "#/components/responses/Command"}}}},
    "/api/v1/session/emergency-stop": {"post": {"operationId": "emergencyStop", "requestBody": {"$ref": "#/components/requestBodies/Command"}, "responses": {"200": {"$ref": "#/components/responses/Command"}}}}
  },
  "components": {
    "parameters": {
      "HistoryFrom": {"name": "from", "in": "query", "schema": {"type": "string", "format": "date-time"}, "description": "Inclusive UTC start"},
      "HistoryTo": {"name": "to", "in": "query", "schema": {"type": "string", "format": "date-time"}, "description": "Exclusive UTC end"},
      "HistoryRun": {"name": "run", "in": "query", "schema": {"type": "array", "items": {"type": "string"}}, "style": "form", "explode": true},
      "HistoryCharacter": {"name": "character", "in": "query", "schema": {"type": "array", "items": {"type": "string"}}, "style": "form", "explode": true},
      "HistoryDifficulty": {"name": "difficulty", "in": "query", "schema": {"type": "array", "items": {"type": "string", "enum": ["normal", "nightmare", "hell"]}}, "style": "form", "explode": true},
      "HistoryOutcome": {"name": "outcome", "in": "query", "schema": {"type": "array", "items": {"type": "string", "enum": ["success", "failed", "aborted", "incomplete", "running"]}}, "style": "form", "explode": true},
      "HistoryReason": {"name": "reason", "in": "query", "schema": {"type": "array", "items": {"type": "string"}}, "style": "form", "explode": true},
      "HistoryPickitProfile": {"name": "pickit_profile", "in": "query", "schema": {"type": "array", "items": {"type": "string"}}, "style": "form", "explode": true},
      "HistoryComparisonSort": {"name": "sort", "in": "query", "schema": {"type": "string", "enum": ["keep_per_hour", "success_rate", "average_duration"], "default": "keep_per_hour"}},
      "HistoryLimit": {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 200, "default": 50}},
      "HistoryCursor": {"name": "cursor", "in": "query", "schema": {"type": "string"}}
    },
    "requestBodies": {"Command": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CommandRequest"}}}}},
    "responses": {"Command": {"description": "Accepted command", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CommandResponse"}}}}},
    "schemas": {
      "StatusDTO": {"type": "object", "required": ["schema_version", "core_version", "state", "generation", "lifecycle_phase", "d2r", "input", "world", "selection", "queue"], "properties": {"schema_version": {"type": "integer"}, "core_version": {"type": "string"}, "state": {"type": "string"}, "generation": {"type": "integer"}, "lifecycle_phase": {"type": "string"}, "pending_intent": {"type": "string"}, "active_run_id": {"type": "string"}, "run_id": {"type": "string"}, "game_id": {"type": "string"}, "step": {"type": "string"}, "d2r": {"$ref": "#/components/schemas/D2RDTO"}, "input": {"$ref": "#/components/schemas/InputDTO"}, "world": {"$ref": "#/components/schemas/WorldDTO"}, "selection": {"$ref": "#/components/schemas/SelectionStatusDTO"}, "queue": {"$ref": "#/components/schemas/QueueStatusDTO"}, "last_result": {"$ref": "#/components/schemas/SessionResultDTO"}, "last_error": {"$ref": "#/components/schemas/ErrorDTO"}}},
      "SessionResultDTO": {"type": "object", "required": ["disposition"], "properties": {"disposition": {"type": "string"}, "reason": {"type": "string"}}},
      "SelectionStatusDTO": {"type": "object", "properties": {"character": {"type": "string"}, "difficulty": {"type": "string"}}},
      "QueueStatusDTO": {"type": "object", "required": ["entries", "default_entries", "index", "cycle", "retry", "started_runs", "consecutive_failures", "total_restarts", "budgets"], "properties": {"entries": {"type": "array", "items": {"type": "string"}}, "default_entries": {"type": "array", "items": {"type": "string"}}, "index": {"type": "integer"}, "cycle": {"type": "integer"}, "retry": {"type": "integer"}, "started_runs": {"type": "integer"}, "consecutive_failures": {"type": "integer"}, "total_restarts": {"type": "integer"}, "budgets": {"$ref": "#/components/schemas/QueueBudgetsDTO"}}},
      "QueueBudgetsDTO": {"type": "object", "required": ["max_runs", "max_duration_ms", "max_consecutive_failures", "max_total_restarts"], "properties": {"max_runs": {"type": "integer"}, "max_duration_ms": {"type": "integer"}, "max_consecutive_failures": {"type": "integer"}, "max_total_restarts": {"type": "integer"}}},
      "D2RDTO": {"type": "object", "required": ["state", "window_bound"], "properties": {"state": {"type": "string"}, "pid": {"type": "integer"}, "window_bound": {"type": "boolean"}, "client_width": {"type": "integer"}, "client_height": {"type": "integer"}}},
      "InputDTO": {"type": "object", "required": ["enabled", "paused", "stopped"], "properties": {"enabled": {"type": "boolean"}, "paused": {"type": "boolean"}, "stopped": {"type": "boolean"}}},
      "WorldDTO": {"type": "object", "required": ["valid", "phase"], "properties": {"valid": {"type": "boolean"}, "phase": {"type": "string"}, "area_id": {"type": "integer"}, "area_name": {"type": "string"}}},
      "LiveEvent": {"type": "object", "required": ["sequence", "timestamp", "event"], "properties": {"sequence": {"type": "integer"}, "timestamp": {"type": "string"}, "event": {"type": "string"}, "session_id": {"type": "string"}, "game_id": {"type": "string"}, "run_id": {"type": "string"}, "run": {"type": "string"}, "act": {"type": "string"}, "step": {"type": "string"}, "area_id": {"type": "integer"}, "area": {"type": "string"}, "reason": {"type": "string"}, "workflow_id": {"type": "string"}, "state": {"type": "string"}, "segment": {"type": "integer"}, "progress": {"type": "number"}, "details": {"type": "object"}}},
      "CatalogDTO": {"type": "object", "required": ["schema_version", "revision", "default_difficulty", "characters", "difficulties", "profiles", "runs"], "properties": {"schema_version": {"type": "integer"}, "revision": {"type": "integer"}, "default_difficulty": {"type": "string"}, "characters": {"type": "array", "items": {"$ref": "#/components/schemas/CharacterCatalogEntry"}}, "difficulties": {"type": "array", "items": {"$ref": "#/components/schemas/DifficultyCatalogEntry"}}, "profiles": {"type": "array", "items": {"$ref": "#/components/schemas/ProfileCatalogEntry"}}, "runs": {"type": "array", "items": {"$ref": "#/components/schemas/RunCatalogEntry"}}}},
      "CharacterCatalogEntry": {"type": "object", "required": ["name", "slug", "selectable"], "properties": {"name": {"type": "string"}, "slug": {"type": "string"}, "expected_class": {"type": "string"}, "selectable": {"type": "boolean"}, "reasons": {"type": "array", "items": {"type": "string"}}}},
      "DifficultyCatalogEntry": {"type": "object", "required": ["id", "display_name"], "properties": {"id": {"type": "string"}, "display_name": {"type": "string"}}},
      "ProfileCatalogEntry": {"type": "object", "required": ["id", "character_class"], "properties": {"id": {"type": "string"}, "character_class": {"type": "string"}}},
      "RunCatalogEntry": {"type": "object", "required": ["run_id", "display_name", "status"], "properties": {"run_id": {"type": "string"}, "display_name": {"type": "string"}, "status": {"type": "string"}, "reasons": {"type": "array", "items": {"type": "string"}}}},
      "CommandRequest": {"type": "object", "required": ["command_id", "expected_generation"], "additionalProperties": false, "properties": {"command_id": {"type": "string"}, "expected_generation": {"type": "integer"}, "payload": {"type": "object"}}},
      "CommandResponse": {"type": "object", "required": ["schema_version", "command_id", "generation", "state"], "properties": {"schema_version": {"type": "integer"}, "command_id": {"type": "string"}, "generation": {"type": "integer"}, "state": {"type": "string"}}},
      "SelectionPreviewRequest": {"type": "object", "required": ["character", "difficulty", "catalog_revision"], "additionalProperties": false, "properties": {"character": {"type": "string"}, "difficulty": {"type": "string"}, "catalog_revision": {"type": "integer"}}},
      "SelectionPreviewDTO": {"type": "object", "required": ["schema_version", "character", "new_difficulty", "affected_routes", "requires_confirmation", "confirmation_token", "catalog_revision", "lifecycle_revision"], "properties": {"schema_version": {"type": "integer"}, "character": {"type": "string"}, "old_difficulty": {"type": "string"}, "new_difficulty": {"type": "string"}, "affected_routes": {"type": "array", "items": {"type": "string"}}, "invalidation_reason": {"type": "string"}, "requires_confirmation": {"type": "boolean"}, "confirmation_token": {"type": "string"}, "catalog_revision": {"type": "integer"}, "lifecycle_revision": {"type": "integer"}}},
      "QueueValidationRequest": {"type": "object", "required": ["entries", "character", "difficulty", "catalog_revision"], "additionalProperties": false, "properties": {"entries": {"type": "array", "items": {"type": "string"}}, "character": {"type": "string"}, "difficulty": {"type": "string"}, "catalog_revision": {"type": "integer"}}},
      "QueueValidationDTO": {"type": "object", "required": ["schema_version", "entries", "character", "difficulty", "catalog_revision", "budgets"], "properties": {"schema_version": {"type": "integer"}, "entries": {"type": "array", "items": {"type": "string"}}, "character": {"type": "string"}, "difficulty": {"type": "string"}, "catalog_revision": {"type": "integer"}, "budgets": {"$ref": "#/components/schemas/QueueBudgetsDTO"}}},
      "SessionStartPayload": {"type": "object", "additionalProperties": false, "required": ["entries", "character", "difficulty", "catalog_revision"], "properties": {"entries": {"type": "array", "items": {"type": "string"}}, "character": {"type": "string"}, "difficulty": {"type": "string"}, "catalog_revision": {"type": "integer"}}},
      "RouteLibraryDTO": {"type": "object", "required": ["schema_version", "revision", "character", "routes"], "properties": {"schema_version": {"type": "integer"}, "revision": {"type": "integer"}, "character": {"type": "string"}, "routes": {"type": "array", "items": {"$ref": "#/components/schemas/RouteEntryDTO"}}}},
